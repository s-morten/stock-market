# Database connection URL.
# SQLite (default for local development):
DATABASE_URL=sqlite:///./reit_data.db
# Oracle example (uncomment and adjust for production):
# DATABASE_URL=oracle+oracledb://user:password@host:1521/service_name

# SEC EDGAR API requires a User-Agent header identifying the caller.
# Format: "Company/App Name contact@email.com"
EDGAR_USER_AGENT=REITDashboard dev@example.com

# Google Gemini API key for LLM-based property count extraction (optional).
# Leave unset to skip Gemini extraction entirely.
GEMINI_API_KEY=

# Set to 0 to disable Gemini even when GEMINI_API_KEY is set (e.g. when the
# service is down or you want a faster ingestion run without it).
GEMINI_ENABLED=1
